# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Upstream code: cloned at pinned commits by scripts/setup_external.sh.
# ITR's licence is "TBA": never commit its source.
external/

# Data: downloaded or regenerated by scripts. Splits and fixtures are committed.
data/*
!data/splits/
!data/fixtures/

# Results: raw runs are large; only small summary tables are committed.
results/*
!results/summary/

# Build output
target/
*.o
build/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Zone.Identifier
*:Zone.Identifier
